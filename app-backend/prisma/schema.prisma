generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_psg")
}

//////////////////////
/// AUTH / USER ///
//////////////////////

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  role       Role     @default(CLIENT)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notifications        Notification[]
  verificationAttempts VerificationAttempt[]
  passwordResets       PasswordReset[]
  refreshTokens        RefreshToken[]

  adminProfile        AdminProfile?
  clientProfile       ClientProfile?
  professionalProfile ProfessionalProfile?
  customConfig        CustomConfig?

  tenantMemberships TenantMembership[]

  affiliationRevisionsSubmitted ProfessionalAffiliationRevision[] @relation("AffiliationRevisionSubmittedBy")
  affiliationRevisionsReviewed  ProfessionalAffiliationRevision[] @relation("AffiliationRevisionReviewedBy")

  affiliationAuditHoldsRequested ProfessionalAffiliationAuditHold[] @relation("AuditHoldRequestedBy")
  affiliationAuditHoldsReleased  ProfessionalAffiliationAuditHold[] @relation("AuditHoldReleasedBy")

  @@index([role])
}

model VerificationAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId, expiresAt])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/////////////////////////////
/// TENANCY / MEMBERSHIP ///
/////////////////////////////

model Tenant {
  id        Int          @id @default(autoincrement())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships              TenantMembership[]
  professionalAffiliations ProfessionalTenantAffiliation[]
  affiliationAuditHolds    ProfessionalAffiliationAuditHold[]

  @@index([status])
}

model TenantMembership {
  id       Int              @id @default(autoincrement())
  userId   Int
  tenantId Int
  role     TenantRole
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

/////////////////////////////////
/// PROFILES / AFFILIATION ///
/////////////////////////////////

model ProfessionalTenantAffiliation {
  id                    Int                           @id @default(autoincrement())
  professionalProfileId Int
  tenantId              Int
  status                ProfessionalAffiliationStatus @default(PENDING_REVIEW)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  professionalProfile ProfessionalProfile                @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  tenant              Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  revisions           ProfessionalAffiliationRevision[]
  auditHolds          ProfessionalAffiliationAuditHold[]
  services            Service[]

  @@unique([professionalProfileId, tenantId])
  @@index([tenantId, status])
  @@index([professionalProfileId, status])
}

model ProfessionalAffiliationRevision {
  id                Int                       @id @default(autoincrement())
  affiliationId     Int
  revisionNumber    Int
  status            AffiliationRevisionStatus @default(PENDING_REVIEW)
  description       String
  submittedByUserId Int
  submittedAt       DateTime                  @default(now())
  reviewedByUserId  Int?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime                  @default(now())

  affiliation ProfessionalTenantAffiliation               @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  submittedBy User                                        @relation("AffiliationRevisionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?                                       @relation("AffiliationRevisionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  socialLinks ProfessionalAffiliationRevisionSocialLink[]

  @@unique([affiliationId, revisionNumber])
  @@index([affiliationId, status])
  @@index([status, submittedAt])
}

model ProfessionalAffiliationRevisionSocialLink {
  id         Int        @id @default(autoincrement())
  revisionId Int
  type       SocialType
  url        String
  createdAt  DateTime   @default(now())

  revision ProfessionalAffiliationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([revisionId, type])
  @@index([revisionId])
}

/// Registro append-only de auditoría. Las columnas de referencia (`tenantId`,
/// `affiliationId`, `revisionId`, `actorUserId`) se mantienen como escalares
/// deliberadamente sin `@relation`: la auditoría no debe bloquearse ni
/// reescribirse por cambios en las entidades referenciadas.
model ProfessionalAffiliationAuditEvent {
  id              Int                            @id @default(autoincrement())
  tenantId        Int
  affiliationId   Int
  revisionId      Int?
  actorUserId     Int?
  action          AffiliationAuditAction
  previousStatus  ProfessionalAffiliationStatus?
  nextStatus      ProfessionalAffiliationStatus?
  reason          String?
  changedFields   Json?
  sourceReference String?
  occurredAt      DateTime                       @default(now())
  createdAt       DateTime                       @default(now())

  auditHolds ProfessionalAffiliationAuditHold[]

  @@index([tenantId, affiliationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([createdAt])
}

/// Retención (hold) que impide la purga de auditoría de una afiliación.
/// `auditEventId` usa `onDelete: SetNull`: cuando el evento ya es purgable, el
/// `DELETE` del evento no queda bloqueado por holds históricos y PostgreSQL
/// anula la referencia, conservando tenant, afiliación, motivo, actor y fechas.
/// La consistencia `tenantId == affiliation.tenantId == event.tenantId` y
/// `event.affiliationId == affiliationId` no es expresable en `CHECK` y se
/// valida en aplicación/adaptador antes de crear el hold.
model ProfessionalAffiliationAuditHold {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  affiliationId     Int?
  auditEventId      Int?
  reason            String
  requestedByUserId Int
  expiresAt         DateTime?
  releasedAt        DateTime?
  releasedByUserId  Int?
  /// `createdAt` debe asignarlo PostgreSQL, no el cliente: `release` fija `releasedAt` con
  /// `statement_timestamp()` (reloj de la base) y el `CHECK releasedAt >= createdAt` no admite
  /// dos relojes. Se mantiene `@default(now())` porque la migración ya declara
  /// `DEFAULT CURRENT_TIMESTAMP` y así no hay deriva en `prisma migrate diff`; pero como Prisma
  /// resuelve `now()` en el cliente, el adaptador hace un INSERT explícito que omite esta
  /// columna y deja actuar el DEFAULT. No cambiar a `dbgenerated`: provoca un `ALTER COLUMN
  /// ... SET DEFAULT` perpetuo en el diff.
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant      Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliation ProfessionalTenantAffiliation?     @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  event       ProfessionalAffiliationAuditEvent? @relation(fields: [auditEventId], references: [id], onDelete: SetNull)
  requestedBy User                               @relation("AuditHoldRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  releasedBy  User?                              @relation("AuditHoldReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, affiliationId])
  @@index([auditEventId])
  @@index([expiresAt, releasedAt])
}

////////////////////
/// ADMIN ///
////////////////////

model AdminProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  name      String
  lastName  String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

////////////////////
/// CLIENT ///
////////////////////

model ClientProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  name      String
  lastName  String?
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([phone])
}

////////////////////////
/// PROFESSIONAL ///
////////////////////////

model ProfessionalProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique
  name               String
  lastName           String?
  phone              String?
  avatar             String?
  description        String
  verificationStatus ProfessionalStatus @default(PENDING)

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties        ProfessionalSpecialty[]
  services           Service[]
  schedules          Schedule[]
  certificates       Certificate[]
  socialLinks        SocialLink[]
  appointments       Appointment[]
  tenantAffiliations ProfessionalTenantAffiliation[]

  @@index([verificationStatus])
  @@index([name])
}

model ProfessionalSpecialty {
  professionalId Int
  specialtyId    Int
  status         SpecialtyStatus @default(PENDING)
  requestedAt    DateTime        @default(now())
  reviewedAt     DateTime?

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialty    Specialty           @relation(fields: [specialtyId], references: [id])

  @@id([professionalId, specialtyId])
  @@index([specialtyId, status])
}

model Certificate {
  id         Int                 @id @default(autoincrement())
  name       String
  issuedBy   String
  issuedDate DateTime
  fileUrl    String
  profileId  Int
  profile    ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model SocialLink {
  id        Int                 @id @default(autoincrement())
  type      SocialType
  url       String
  profileId Int
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type])
}

////////////////////
/// CATALOG ///
////////////////////

model Specialty {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionalSpecialties ProfessionalSpecialty[]
  services                Service[]

  @@index([isActive])
}

/// Oferta clínica reservable (D3): pertenece a una afiliación profesional–tenant y no se
/// hereda entre clínicas del mismo profesional.
///
/// Migración en dos etapas (D8, Misión 3): `affiliationId` se agrega **nullable** para no
/// romper las filas legacy mientras el backfill no tenga mappings aprobados. Una vez aplicado
/// el backfill y verificado que ninguna fila queda sin afiliación, una migración posterior lo
/// hará `NOT NULL` y eliminará `profileId`, que queda **deprecado** desde ahora.
model Service {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  durationMin   Int
  price         Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  /// Deprecado (D3): referencia global al perfil. Se conserva mientras el backfill no esté
  /// aplicado y será retirado tras poblar `affiliationId` en todas las filas.
  profileId     Int
  /// Afiliación profesional–tenant propietaria de la oferta. `null` solo en filas legacy
  /// pendientes de backfill; ninguna oferta nueva debe crearse sin afiliación.
  affiliationId Int?
  specialtyId   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile      ProfessionalProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  affiliation  ProfessionalTenantAffiliation? @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  specialty    Specialty                      @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]

  /// Unicidad por afiliación (D3): permite el mismo nombre de oferta en consultorios distintos
  /// con términos comerciales independientes. Reemplaza la restricción legacy
  /// `@@unique([profileId, name])`; PostgreSQL trata cada `NULL` como distinto, de modo que las
  /// filas legacy sin afiliación no colisionan entre sí mientras se completa el backfill.
  @@unique([affiliationId, name])
  @@index([profileId, specialtyId])
  @@index([affiliationId, specialtyId])
  @@index([isActive])
}

model Schedule {
  id        Int      @id @default(autoincrement())
  profileId Int
  dayOfWeek Int
  startMin  Int
  endMin    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayOfWeek, startMin])
  @@index([profileId, dayOfWeek])
  @@index([isActive])
}

////////////////////
/// APPOINTMENT ///
////////////////////

model GuestClient {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([email])
  @@index([phone])
}

model Appointment {
  id                    Int               @id @default(autoincrement())
  clientProfileId       Int?
  guestId               Int?
  serviceId             Int
  professionalProfileId Int
  date                  DateTime
  startMin              Int
  endMin                Int
  status                AppointmentStatus @default(PENDING)
  payment               PaymentStatus     @default(PENDING)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  clientProfile ClientProfile?      @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  guest         GuestClient?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  service       Service             @relation(fields: [serviceId], references: [id])
  professional  ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])
  review        Review?
  notifications Notification[]

  @@unique([professionalProfileId, date, startMin])
  @@index([professionalProfileId, date])
  @@index([clientProfileId, status])
  @@index([serviceId])
}

model Review {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

////////////////////
/// NOTIFICATION ///
////////////////////

model Notification {
  id            Int              @id @default(autoincrement())
  userId        Int
  appointmentId Int?
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

////////////////////
/// CONFIG ///
////////////////////

model CustomConfig {
  id                   Int        @id @default(autoincrement())
  userId               Int        @unique
  language             Language   @default(ES)
  theme                Theme      @default(LIGHT)
  layout               LayoutType @default(SIDEBAR)
  preferences          Json?
  notificationsEnabled Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

////////////////////
/// ENUMS ///
////////////////////

/// Auth / identidad
enum Role {
  ADMIN
  PROFESSIONAL
  CLIENT
}

/// Perfiles
enum ProfessionalStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum SpecialtyStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Tenancy / membership
enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum TenantRole {
  OWNER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Afiliación profesional–tenant
enum ProfessionalAffiliationStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  WITHDRAWN
}

enum AffiliationRevisionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum AffiliationAuditAction {
  APPLY
  SUBMIT_CONTENT
  SUPERSEDE_CONTENT
  APPROVE_AFFILIATION
  REJECT_AFFILIATION
  APPROVE_CONTENT
  REJECT_CONTENT
  SUSPEND
  REACTIVATE
  WITHDRAW
  REOPEN
  BACKFILL
}

/// Citas
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// Preferencias de UI
enum LayoutType {
  SIDEBAR
  TOPBAR
}

enum Language {
  ES
  EN
}

enum Theme {
  LIGHT
  DARK
}

/// Enlaces sociales
enum SocialType {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  WEBSITE
}

/// Notificaciones
enum NotificationType {
  WELCOME
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_STATUS_CHANGED
  REVIEW_REQUEST
  SYSTEM
}
